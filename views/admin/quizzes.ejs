<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quizzes - Quizzy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #0a0a0a;
            color: white;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-radius: 8px;
            color: #9ca3af;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .nav-item svg {
            margin-right: 12px;
        }

        .nav-item:hover {
            background: #1a1a1a;
            color: white;
        }

        .nav-item.active {
            background: #7c3aed;
            color: white;
        }

        .quiz-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 24px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .quiz-card:hover {
            transform: translateY(-4px);
            border-color: #7c3aed;
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.2);
        }

        .quiz-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            z-index: 1000;
        }

        .modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            max-width: 900px;
            width: 95%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .toggle-switch {
            position: relative;
            width: 48px;
            height: 24px;
            background: #2a2a2a;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .toggle-switch.active {
            background: #7c3aed;
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            background: white;
            border-radius: 50%;
            top: 2px;
            left: 2px;
            transition: all 0.3s ease;
        }

        .toggle-switch.active::after {
            left: 26px;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #1a1a1a;
        }

        ::-webkit-scrollbar-thumb {
            background: #2a2a2a;
            border-radius: 4px;
        }
    </style>
</head>
<body class="flex">
    <!-- Sidebar -->
    <%- include('../partials/dashboard/admin-sidebar') %>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
        <!-- Top Bar -->
        <%- include('../partials/dashboard/navbar') %>

        <!-- Quizzes Content -->
        <div class="p-8">
            <!-- Header -->
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold mb-2">Quizzes</h1>
                    <p class="text-gray-400">Create, manage and analyze your quizzes</p>
                </div>
                <button id="createQuizBtn" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2.5 rounded-lg font-medium flex items-center space-x-2 transition">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Create New Quiz</span>
                </button>
            </div>

            <!-- Quiz Library -->
            <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl p-6">
                <!-- Library Header -->
                <div class="mb-6">
                    <h2 class="text-xl font-bold mb-1">Quiz Library</h2>
                    <p class="text-gray-400 text-sm">Browse and manage all your quizzes</p>
                </div>

                <!-- Quiz Cards -->
                <div id="quizzesContainer" class="space-y-4">
                    <div class="text-center py-12">
                        <p class="text-gray-400">Loading quizzes...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>


            </div>
        </div>
    </div>

    <!-- Create Quiz Modal -->
    <div id="quizModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b border-[#2a2a2a]">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-bold mb-1">Create New Quiz</h2>
                        <p class="text-sm text-gray-400">Configure quiz settings</p>
                    </div>
                    <button id="closeModal" class="text-gray-400 hover:text-white">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <form id="quizForm" class="p-6">
                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-bold mb-4">Quiz Details</h3>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Quiz Title</label>
                            <input type="text" id="quizTitle" required placeholder="Introduction to Science" class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Description</label>
                            <textarea id="quizDescription" rows="4" placeholder="Test your knowledge..." class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600 resize-none"></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Theme</label>
                            <select id="quizTheme" required class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600">
                                <option value="">Loading...</option>
                            </select>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-bold mb-4">Quiz Settings</h3>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Time Limit</label>
                            <div class="flex items-center space-x-3">
                                <input type="number" id="quizTimeLimit" value="15" min="1" max="180" class="flex-1 bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600">
                                <span class="text-gray-400 text-sm">minutes</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Passing Score</label>
                            <div class="flex items-center space-x-3">
                                <input type="number" id="quizPassingScore" value="70" min="0" max="100" class="flex-1 bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600">
                                <span class="text-gray-400 text-sm">%</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg">
                            <div>
                                <h4 class="font-semibold mb-1">Randomize Questions</h4>
                                <p class="text-xs text-gray-400">Random order</p>
                            </div>
                            <div class="toggle-switch" id="randomizeToggle" data-value="false"></div>
                        </div>
                        <div class="flex items-center justify-between p-4 bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg">
                            <div>
                                <h4 class="font-semibold mb-1">Immediate Results</h4>
                                <p class="text-xs text-gray-400">Show after each question</p>
                            </div>
                            <div class="toggle-switch active" id="immediateToggle" data-value="true"></div>
                        </div>
                    </div>
                </div>
                <div class="flex items-center justify-end space-x-3 pt-6 mt-6 border-t border-[#2a2a2a]">
                    <button type="button" id="cancelBtn" class="px-6 py-2.5 bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg text-white hover:bg-[#1a1a1a]">Cancel</button>
                    <button type="submit" class="px-8 py-2.5 bg-purple-600 hover:bg-purple-700 rounded-lg text-white font-medium">Next</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let quizzes = [];
        let themes = [];

        const colorClasses = {
            purple: 'bg-purple-600/20 text-purple-500',
            blue: 'bg-blue-600/20 text-blue-500',
            green: 'bg-green-600/20 text-green-500',
            orange: 'bg-orange-600/20 text-orange-500',
            yellow: 'bg-yellow-600/20 text-yellow-500',
            pink: 'bg-pink-600/20 text-pink-500',
            red: 'bg-red-600/20 text-red-500',
            cyan: 'bg-cyan-600/20 text-cyan-500'
        };

        document.addEventListener('DOMContentLoaded', () => {
            loadQuizzes();
            loadThemes();
            setupEventListeners();
        });

        function setupEventListeners() {
            document.getElementById('createQuizBtn').addEventListener('click', () => {
                document.getElementById('quizModal').classList.add('active');
            });
            document.getElementById('closeModal').addEventListener('click', closeModal);
            document.getElementById('cancelBtn').addEventListener('click', closeModal);
            document.getElementById('randomizeToggle').addEventListener('click', function() {
                this.classList.toggle('active');
                this.dataset.value = this.classList.contains('active');
            });
            document.getElementById('immediateToggle').addEventListener('click', function() {
                this.classList.toggle('active');
                this.dataset.value = this.classList.contains('active');
            });
            document.getElementById('quizForm').addEventListener('submit', handleSubmit);
        }

        function closeModal() {
            document.getElementById('quizModal').classList.remove('active');
        }

        async function loadQuizzes() {
            try {
                const res = await fetch('/api/quizzes');
                const data = await res.json();
                if (data.success) {
                    quizzes = data.quizzes;
                    renderQuizzes();
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function loadThemes() {
            try {
                const res = await fetch('/api/themes');
                const data = await res.json();
                if (data.success) {
                    themes = data.themes;
                    const themeSelect = document.getElementById('quizTheme');
                    themeSelect.innerHTML = '<option value="">Select theme</option>' + 
                        themes.map(t => '<option value="' + t.id + '">' + t.icon + ' ' + t.name + '</option>').join('');
                }
            } catch (e) {
                console.error(e);
            }
        }

        function renderQuizzes() {
            const container = document.getElementById('quizzesContainer');
            if (quizzes.length === 0) {
                container.innerHTML = '<div class="text-center py-12"><p class="text-gray-400">No quizzes yet. Create your first quiz!</p></div>';
                return;
            }

            container.innerHTML = quizzes.map(q => {
                const theme = q.theme || {};
                const colorClass = colorClasses[theme.color] || 'bg-purple-600/20 text-purple-500';
                const timeAgo = getTimeAgo(q.createdAt);
                return '<div class="quiz-card">' +
                    '<div class="flex items-start justify-between">' +
                    '<div class="flex items-start space-x-4 flex-1">' +
                    '<div class="quiz-icon ' + colorClass + '">' + (theme.icon || '📚') + '</div>' +
                    '<div class="flex-1">' +
                    '<h3 class="text-lg font-bold mb-1">' + q.title + '</h3>' +
                    '<p class="text-sm text-gray-400 mb-4">' + (q.description || 'No description') + '</p>' +
                    '<div class="flex items-center space-x-6 text-sm text-gray-400">' +
                    '<span>' + q.total_questions + ' questions</span>' +
                    '<span>' + q.time_limit + ' min</span>' +
                    '<span>' + q.total_completions + ' completions</span>' +
                    '<span class="text-gray-500">' + timeAgo + '</span>' +
                    '</div></div></div>' +
                    '<div class="flex items-center space-x-2">' +
                    '<button onclick="viewQuiz(' + q.id + ')" class="px-4 py-2 bg-[#0a0a0a] hover:bg-purple-600 border border-[#2a2a2a] rounded-lg text-sm font-medium">View</button>' +
                    '<button onclick="deleteQuiz(' + q.id + ')" class="p-2 hover:bg-red-500/10 rounded-lg text-red-400">' +
                    '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">' +
                    '<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>' +
                    '</svg></button></div></div></div>';
            }).join('');
        }

        function getTimeAgo(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const seconds = Math.floor((now - date) / 1000);
            if (seconds < 60) return 'just now';
            if (seconds < 3600) return Math.floor(seconds / 60) + ' minutes ago';
            if (seconds < 86400) return Math.floor(seconds / 3600) + ' hours ago';
            if (seconds < 604800) return Math.floor(seconds / 86400) + ' days ago';
            return date.toLocaleDateString();
        }

        async function handleSubmit(e) {
            e.preventDefault();
            const formData = {
                title: document.getElementById('quizTitle').value,
                description: document.getElementById('quizDescription').value,
                theme_id: parseInt(document.getElementById('quizTheme').value),
                time_limit: parseInt(document.getElementById('quizTimeLimit').value),
                passing_score: parseInt(document.getElementById('quizPassingScore').value),
                randomize_questions: document.getElementById('randomizeToggle').dataset.value === 'true',
                immediate_results: document.getElementById('immediateToggle').dataset.value === 'true'
            };

            try {
                const res = await fetch('/api/quizzes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/admin/quiz/create?id=' + data.quiz.id;
                }
            } catch (e) {
                console.error(e);
            }
        }

        function viewQuiz(id) {
            window.location.href = '/admin/quiz/create?id=' + id;
        }

        async function deleteQuiz(id) {
            if (!confirm('Delete this quiz?')) return;
            try {
                const res = await fetch('/api/quizzes/' + id, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) loadQuizzes();
            } catch (e) {
                console.error(e);
            }
        }
    </script>
</body>
</html>

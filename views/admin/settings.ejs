    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Quizzy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #0a0a0a;
            color: white;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-radius: 8px;
            color: #9ca3af;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .nav-item svg {
            margin-right: 12px;
        }

        .nav-item:hover {
            background: #1a1a1a;
            color: white;
        }

        .nav-item.active {
            background: #7c3aed;
            color: white;
        }

        .theme-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .theme-card:hover {
            transform: translateY(-2px);
            border-color: #7c3aed;
        }

        .theme-icon {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            z-index: 1000;
            animation: fadeIn 0.2s ease;
        }

        .modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            animation: slideUp 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* Emoji Picker */
        .emoji-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 8px;
            max-height: 200px;
            overflow-y: auto;
            padding: 12px;
            background: #0a0a0a;
            border-radius: 8px;
        }

        .emoji-item {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.2s ease;
            border: 2px solid transparent;
        }

        .emoji-item:hover {
            background: #2a2a2a;
            transform: scale(1.1);
        }

        .emoji-item.selected {
            background: #7c3aed;
            border-color: #a78bfa;
        }

        .emoji-display {
            width: 80px;
            height: 80px;
            border-radius: 12px;
            background: #0a0a0a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            border: 2px solid #2a2a2a;
        }

        /* Loading State */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #2a2a2a;
            border-radius: 50%;
            border-top-color: #7c3aed;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #1a1a1a;
        }

        ::-webkit-scrollbar-thumb {
            background: #2a2a2a;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #3a3a3a;
        }
    </style>
</head>
<body class="flex">
    <!-- Sidebar -->
    <%- include('../partials/dashboard/admin-sidebar') %>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
        <!-- Top Bar -->
        <%- include('../partials/dashboard/navbar') %>

        <!-- Settings Content -->
        <div class="p-8">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold mb-2">Settings</h1>
                <p class="text-gray-400">Manage quiz themes and categories</p>
            </div>

            <!-- Themes Section -->
            <div class="mb-8">
                <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl p-6">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-xl font-bold mb-1">Quiz Themes</h2>
                            <p class="text-gray-400 text-sm">Manage quiz categories and subjects</p>
                        </div>
                        <button id="addThemeBtn" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2.5 rounded-lg font-medium flex items-center space-x-2 transition">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                            </svg>
                            <span>Add New Theme</span>
                        </button>
                    </div>

                    <!-- Themes Grid -->
                    <div id="themesGrid" class="grid grid-cols-4 gap-4 max-h-[500px] overflow-y-auto pr-2">
                        <!-- Loading State -->
                        <div class="col-span-4 text-center py-12">
                            <div class="loading mx-auto mb-3"></div>
                            <p class="text-gray-400">Loading themes...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Theme Modal -->
    <div id="themeModal" class="modal">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="p-6 border-b border-[#2a2a2a]">
                <div class="flex items-center justify-between">
                    <h2 id="modalTitle" class="text-xl font-bold">Add New Theme</h2>
                    <button id="closeModal" class="text-gray-400 hover:text-white transition">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <form id="themeForm" class="p-6 space-y-6">
                <input type="hidden" id="themeId" name="id">

                <!-- Theme Name -->
                <div>
                    <label class="block text-sm font-medium mb-2">Theme Name *</label>
                    <input 
                        type="text" 
                        id="themeName" 
                        name="name" 
                        required
                        placeholder="e.g., Science, Mathematics"
                        class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600 transition"
                    >
                </div>

                <!-- Theme Icon (Emoji Picker) -->
                <div>
                    <label class="block text-sm font-medium mb-2">Theme Icon *</label>
                    <div class="flex items-center space-x-4 mb-3">
                        <div id="selectedEmoji" class="emoji-display">
                            📚
                        </div>
                        <div class="flex-1">
                            <p class="text-sm text-gray-400">Choose an emoji for your theme</p>
                            <input type="hidden" id="themeIcon" name="icon" value="📚">
                        </div>
                    </div>
                    
                    <!-- Emoji Grid -->
                    <div class="emoji-grid">
                        <div class="emoji-item selected" data-emoji="📚">📚</div>
                        <div class="emoji-item" data-emoji="🔬">🔬</div>
                        <div class="emoji-item" data-emoji="🔢">🔢</div>
                        <div class="emoji-item" data-emoji="💻">💻</div>
                        <div class="emoji-item" data-emoji="🗣️">🗣️</div>
                        <div class="emoji-item" data-emoji="📜">📜</div>
                        <div class="emoji-item" data-emoji="🎨">🎨</div>
                        <div class="emoji-item" data-emoji="⚽">⚽</div>
                        <div class="emoji-item" data-emoji="🌍">🌍</div>
                        <div class="emoji-item" data-emoji="🎵">🎵</div>
                        <div class="emoji-item" data-emoji="🎭">🎭</div>
                        <div class="emoji-item" data-emoji="🏆">🏆</div>
                        <div class="emoji-item" data-emoji="🌟">🌟</div>
                        <div class="emoji-item" data-emoji="⚡">⚡</div>
                        <div class="emoji-item" data-emoji="🔥">🔥</div>
                        <div class="emoji-item" data-emoji="💡">💡</div>
                        <div class="emoji-item" data-emoji="🎯">🎯</div>
                        <div class="emoji-item" data-emoji="🚀">🚀</div>
                        <div class="emoji-item" data-emoji="🌈">🌈</div>
                        <div class="emoji-item" data-emoji="⭐">⭐</div>
                        <div class="emoji-item" data-emoji="🎪">🎪</div>
                        <div class="emoji-item" data-emoji="🎬">🎬</div>
                        <div class="emoji-item" data-emoji="📱">📱</div>
                        <div class="emoji-item" data-emoji="🎮">🎮</div>
                        <div class="emoji-item" data-emoji="🏀">🏀</div>
                        <div class="emoji-item" data-emoji="⚾">⚾</div>
                        <div class="emoji-item" data-emoji="🎾">🎾</div>
                        <div class="emoji-item" data-emoji="🏐">🏐</div>
                        <div class="emoji-item" data-emoji="🏈">🏈</div>
                        <div class="emoji-item" data-emoji="🥊">🥊</div>
                        <div class="emoji-item" data-emoji="🧪">🧪</div>
                        <div class="emoji-item" data-emoji="🔭">🔭</div>
                        <div class="emoji-item" data-emoji="🌌">🌌</div>
                        <div class="emoji-item" data-emoji="🧬">🧬</div>
                        <div class="emoji-item" data-emoji="⚙️">⚙️</div>
                        <div class="emoji-item" data-emoji="🛠️">🛠️</div>
                        <div class="emoji-item" data-emoji="📐">📐</div>
                        <div class="emoji-item" data-emoji="📏">📏</div>
                        <div class="emoji-item" data-emoji="✏️">✏️</div>
                        <div class="emoji-item" data-emoji="📝">📝</div>
                    </div>
                </div>

                <!-- Theme Description -->
                <div>
                    <label class="block text-sm font-medium mb-2">Description</label>
                    <input 
                        type="text" 
                        id="themeDescription" 
                        name="description" 
                        placeholder="e.g., Biology, Chemistry, Physics"
                        class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600 transition"
                    >
                </div>

                <!-- Theme Color -->
                <div>
                    <label class="block text-sm font-medium mb-2">Theme Color</label>
                    <select 
                        id="themeColor" 
                        name="color"
                        class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-purple-600 transition"
                    >
                        <option value="purple">Purple</option>
                        <option value="blue">Blue</option>
                        <option value="green">Green</option>
                        <option value="orange">Orange</option>
                        <option value="yellow">Yellow</option>
                        <option value="pink">Pink</option>
                        <option value="red">Red</option>
                        <option value="cyan">Cyan</option>
                    </select>
                </div>

                <!-- Modal Footer -->
                <div class="flex items-center justify-end space-x-3 pt-4 border-t border-[#2a2a2a]">
                    <button 
                        type="button" 
                        id="cancelBtn"
                        class="px-6 py-2.5 bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg text-white hover:bg-[#1a1a1a] transition"
                    >
                        Cancel
                    </button>
                    <button 
                        type="submit" 
                        id="submitBtn"
                        class="px-6 py-2.5 bg-purple-600 hover:bg-purple-700 rounded-lg text-white font-medium transition"
                    >
                        Save Theme
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // State
        let themes = [];
        let editingThemeId = null;
        let selectedEmoji = '📚';

        // Color classes mapping
        const colorClasses = {
            purple: 'bg-purple-600/20',
            blue: 'bg-blue-600/20',
            green: 'bg-green-600/20',
            orange: 'bg-orange-600/20',
            yellow: 'bg-yellow-600/20',
            pink: 'bg-pink-600/20',
            red: 'bg-red-600/20',
            cyan: 'bg-cyan-600/20'
        };

        // DOM Elements
        const themesGrid = document.getElementById('themesGrid');
        const themeModal = document.getElementById('themeModal');
        const addThemeBtn = document.getElementById('addThemeBtn');
        const closeModal = document.getElementById('closeModal');
        const cancelBtn = document.getElementById('cancelBtn');
        const themeForm = document.getElementById('themeForm');
        const modalTitle = document.getElementById('modalTitle');
        const selectedEmojiDisplay = document.getElementById('selectedEmoji');
        const emojiItems = document.querySelectorAll('.emoji-item');

        // Load themes on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadThemes();
            setupEventListeners();
        });

        // Setup Event Listeners
        function setupEventListeners() {
            addThemeBtn.addEventListener('click', openAddModal);
            closeModal.addEventListener('click', closeModalHandler);
            cancelBtn.addEventListener('click', closeModalHandler);
            themeForm.addEventListener('submit', handleSubmit);

            // Emoji selection
            emojiItems.forEach(item => {
                item.addEventListener('click', () => {
                    selectEmoji(item.dataset.emoji);
                });
            });

            // Close modal on outside click
            themeModal.addEventListener('click', (e) => {
                if (e.target === themeModal) {
                    closeModalHandler();
                }
            });
        }

        // Load Themes from API
        async function loadThemes() {
            try {
                const response = await fetch('/api/themes');
                const data = await response.json();

                if (data.success) {
                    themes = data.themes;
                    renderThemes();
                } else {
                    showError('Failed to load themes');
                }
            } catch (error) {
                console.error('Error loading themes:', error);
                showError('Error loading themes');
            }
        }

        // Render Themes
        function renderThemes() {
            if (themes.length === 0) {
                themesGrid.innerHTML = `
                    <div class="col-span-4 text-center py-12">
                        <p class="text-gray-400">No themes yet. Add your first theme!</p>
                    </div>
                `;
                return;
            }

            themesGrid.innerHTML = themes.map(theme => `
                <div class="theme-card">
                    <div class="flex flex-col items-center text-center">
                        <div class="theme-icon ${colorClasses[theme.color] || 'bg-purple-600/20'} mb-4">
                            ${theme.icon}
                        </div>
                        <h3 class="font-bold mb-1">${theme.name}</h3>
                        <p class="text-xs text-gray-400 mb-3">${theme.description || ''}</p>
                        <div class="flex items-center space-x-2 mt-3 w-full">
                            <button onclick="editTheme(${theme.id})" class="flex-1 bg-[#0a0a0a] hover:bg-purple-600 border border-[#2a2a2a] py-1.5 rounded-lg text-xs transition">
                                Edit
                            </button>
                            <button onclick="deleteTheme(${theme.id}, '${theme.name}')" class="p-1.5 hover:bg-red-500/10 rounded-lg text-red-400 transition">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Open Add Modal
        function openAddModal() {
            editingThemeId = null;
            modalTitle.textContent = 'Add New Theme';
            themeForm.reset();
            selectEmoji('📚');
            themeModal.classList.add('active');
        }

        // Edit Theme
        function editTheme(id) {
            const theme = themes.find(t => t.id === id);
            if (!theme) return;

            editingThemeId = id;
            modalTitle.textContent = 'Edit Theme';
            
            document.getElementById('themeId').value = theme.id;
            document.getElementById('themeName').value = theme.name;
            document.getElementById('themeDescription').value = theme.description || '';
            document.getElementById('themeColor').value = theme.color;
            selectEmoji(theme.icon);
            
            themeModal.classList.add('active');
        }

        // Delete Theme
        async function deleteTheme(id, name) {
            if (!confirm(`Are you sure you want to delete "${name}"?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/themes/${id}`, {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                    loadThemes();
                    showSuccess('Theme deleted successfully');
                } else {
                    showError(data.message || 'Failed to delete theme');
                }
            } catch (error) {
                console.error('Error deleting theme:', error);
                showError('Error deleting theme');
            }
        }

        // Handle Form Submit
        async function handleSubmit(e) {
            e.preventDefault();

            const formData = {
                name: document.getElementById('themeName').value,
                icon: document.getElementById('themeIcon').value,
                description: document.getElementById('themeDescription').value,
                color: document.getElementById('themeColor').value
            };

            try {
                let response;
                
                if (editingThemeId) {
                    // Update existing theme
                    response = await fetch(`/api/themes/${editingThemeId}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                } else {
                    // Create new theme
                    response = await fetch('/api/themes', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                }

                const data = await response.json();

                if (data.success) {
                    closeModalHandler();
                    loadThemes();
                    showSuccess(editingThemeId ? 'Theme updated successfully' : 'Theme created successfully');
                } else {
                    showError(data.message || 'Failed to save theme');
                }
            } catch (error) {
                console.error('Error saving theme:', error);
                showError('Error saving theme');
            }
        }

        // Select Emoji
        function selectEmoji(emoji) {
            selectedEmoji = emoji;
            document.getElementById('themeIcon').value = emoji;
            selectedEmojiDisplay.textContent = emoji;

            // Update UI
            emojiItems.forEach(item => {
                item.classList.toggle('selected', item.dataset.emoji === emoji);
            });
        }

        // Close Modal
        function closeModalHandler() {
            themeModal.classList.remove('active');
            editingThemeId = null;
            themeForm.reset();
        }

        // Show Success Message
        function showSuccess(message) {
            alert('✅ ' + message);
        }

        // Show Error Message
        function showError(message) {
            alert('❌ ' + message);
        }

        // Make functions global for onclick handlers
        window.editTheme = editTheme;
        window.deleteTheme = deleteTheme;
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Quizzy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #0a0a0a;
            color: white;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-radius: 8px;
            color: #9ca3af;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .nav-item svg {
            margin-right: 12px;
        }

        .nav-item:hover {
            background: #1a1a1a;
            color: white;
        }

        .nav-item.active {
            background: #7c3aed;
            color: white;
        }

        .student-row {
            transition: all 0.3s ease;
        }

        .student-row:hover {
            background: #1a1a1a;
        }

        .action-btn {
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .student-row:hover .action-btn {
            opacity: 1;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }
    </style>
</head>
<body class="flex">
    <!-- Sidebar -->
    <%- include('../partials/dashboard/admin-sidebar') %>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
        <!-- Top Bar -->
        <%- include('../partials/dashboard/navbar') %>

        <!-- Students Content -->
        <div class="p-8">
            <!-- Header -->
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold mb-2">Students</h1>
                    <p class="text-gray-400">Manage your students and track their progress</p>
                </div>
              
            </div>

            <!-- Student Directory -->
            <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden">
                <!-- Directory Header -->
                <div class="p-6 border-b border-[#2a2a2a]">
                    <h2 class="text-xl font-bold mb-1">Student Directory</h2>
                    <p class="text-gray-400 text-sm">View and manage all your students</p>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-[#0a0a0a] border-b border-[#2a2a2a]">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Class</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Quizzes Taken</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Average Score</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Last Active</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTableBody" class="divide-y divide-[#2a2a2a]">
                            <!-- Students will be loaded dynamically -->
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-400">
                                    <div class="flex items-center justify-center space-x-2">
                                        <svg class="animate-spin h-5 w-5 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span>Loading students...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        let students = [];

        // Gradient colors for avatars
        const gradients = [
            'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
            'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
            'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
            'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
            'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
            'linear-gradient(135deg, #30cfd0 0%, #330867 100%)',
            'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
            'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)'
        ];

        // Load students on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadStudents();
        });

        // Load students from API
        async function loadStudents() {
            try {
                const response = await fetch('/api/users/students');
                const data = await response.json();

                if (data.success) {
                    students = data.students;
                    renderStudents();
                } else {
                    showError('Failed to load students');
                }
            } catch (error) {
                console.error('Error loading students:', error);
                showError('Error loading students');
            }
        }

        // Render students table
        function renderStudents() {
            const tbody = document.getElementById('studentsTableBody');
            
            if (students.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center">
                            <div class="text-gray-400">
                                <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                </svg>
                                <p class="text-lg font-semibold mb-2">No Students Found</p>
                                <p class="text-sm">Students will appear here once they register</p>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            // Render all students
            tbody.innerHTML = students.map((student, index) => {
                const initials = getInitials(student.username);
                const gradient = gradients[index % gradients.length];
                const relativeTime = getRelativeTime(student.lastActive);
                
                return `
                    <tr class="student-row">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div class="avatar" style="background: ${gradient};">
                                    ${initials}
                                </div>
                                <div class="ml-4">
                                    <div class="text-sm font-semibold">${escapeHtml(student.username)}</div>
                                    <div class="text-xs text-gray-400">${escapeHtml(student.email)}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm text-gray-300">${student.class || 'N/A'}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm text-gray-300">${student.quizzesTaken}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm font-medium ${getScoreColor(student.averageScore)}">
                                ${student.averageScore > 0 ? student.averageScore + '%' : 'N/A'}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm text-gray-400">${relativeTime}</span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Get initials from username
        function getInitials(name) {
            const parts = name.split(' ');
            if (parts.length >= 2) {
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }
            return name.substring(0, 2).toUpperCase();
        }

        // Get score color class
        function getScoreColor(score) {
            if (score >= 80) return 'text-green-500';
            if (score >= 60) return 'text-yellow-500';
            if (score > 0) return 'text-red-500';
            return 'text-gray-500';
        }

        // Get relative time
        function getRelativeTime(date) {
            if (!date) return 'Never';
            
            const now = new Date();
            const past = new Date(date);
            const diffMs = now - past;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
            if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
            if (diffDays < 30) return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
            
            return past.toLocaleDateString();
        }

        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Show error message
        function showError(message) {
            const tbody = document.getElementById('studentsTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center">
                        <div class="text-red-400">
                            <svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <p class="text-lg font-semibold mb-2">Error Loading Students</p>
                            <p class="text-sm">${message}</p>
                            <button onclick="loadStudents()" class="mt-4 px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg text-white text-sm transition">
                                Try Again
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }
    </script>
</body>
</html>

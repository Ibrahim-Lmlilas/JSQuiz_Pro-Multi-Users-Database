<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Quizzy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #0a0a0a;
            color: white;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-radius: 8px;
            color: #9ca3af;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .nav-item svg {
            margin-right: 12px;
        }

        .nav-item:hover {
            background: #1a1a1a;
            color: white;
        }

        .nav-item.active {
            background: #7c3aed;
            color: white;
        }

        .student-row {
            transition: all 0.3s ease;
        }

        .student-row:hover {
            background: #1a1a1a;
        }

        .action-btn {
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .student-row:hover .action-btn {
            opacity: 1;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }
    </style>
</head>
<body class="flex">
    <!-- Sidebar -->
    <%- include('../partials/dashboard/admin-sidebar') %>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
        <!-- Top Bar -->
        <%- include('../partials/dashboard/navbar') %>

        <!-- Students Content -->
        <div class="p-8">
            <!-- Header -->
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold mb-2">Students</h1>
                    <p class="text-gray-400">Manage your students and track their progress</p>
                </div>
                <button class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2.5 rounded-lg font-medium flex items-center space-x-2 transition">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"></path>
                    </svg>
                    <span>Invite Students</span>
                </button>
            </div>

            <!-- Student Directory -->
            <div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden">
                <!-- Directory Header -->
                <div class="p-6 border-b border-[#2a2a2a]">
                    <h2 class="text-xl font-bold mb-1">Student Directory</h2>
                    <p class="text-gray-400 text-sm">View and manage all your students</p>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-[#0a0a0a] border-b border-[#2a2a2a]">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Class</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Quizzes Taken</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Average Score</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Last Active</th>
                                <th class="px-6 py-4 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#2a2a2a]">
                            <!-- Student 1 -->
                            <tr class="student-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="avatar" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                            AJ
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-semibold">Alex Johnson</div>
                                            <div class="text-xs text-gray-400">alex.johnson@email.com</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">10A</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">12</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-medium text-green-500">85%</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-400">2 hours ago</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <button class="action-btn text-gray-400 hover:text-white transition p-2">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>

                            <!-- Student 2 -->
                            <tr class="student-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="avatar" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                            EW
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-semibold">Emma Watson</div>
                                            <div class="text-xs text-gray-400">emma.watson@email.com</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">10A</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">12</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-medium text-green-500">85%</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-400">2 hours ago</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <button class="action-btn text-gray-400 hover:text-white transition p-2">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>

                            <!-- Student 3 -->
                            <tr class="student-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="avatar" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                                            MC
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-semibold">Michael Clark</div>
                                            <div class="text-xs text-gray-400">michael.clark@email.com</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">10A</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">12</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-medium text-green-500">85%</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-400">2 hours ago</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <button class="action-btn text-gray-400 hover:text-white transition p-2">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>

                            <!-- Student 4 -->
                            <tr class="student-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="avatar" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                                            SG
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-semibold">Sophia Green</div>
                                            <div class="text-xs text-gray-400">sophia.green@email.com</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">10B</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">18</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-medium text-green-500">92%</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-400">1 hour ago</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <button class="action-btn text-gray-400 hover:text-white transition p-2">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>

                            <!-- Student 5 -->
                            <tr class="student-row">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="avatar" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                                            LW
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-semibold">Lucia Wilde</div>
                                            <div class="text-xs text-gray-400">lucia.wilde@email.com</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">10C</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-300">15</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm font-medium text-green-500">88%</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="text-sm text-gray-400">3 hours ago</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <button class="action-btn text-gray-400 hover:text-white transition p-2">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="px-6 py-4 border-t border-[#2a2a2a] flex items-center justify-between">
                    <div class="text-sm text-gray-400">
                        Showing <span class="font-medium text-white">1</span> to <span class="font-medium text-white">5</span> of <span class="font-medium text-white">47</span> students
                    </div>
                    <div class="flex space-x-2">
                        <button class="px-3 py-1 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a] text-gray-400 hover:text-white hover:border-purple-600 transition text-sm">
                            Previous
                        </button>
                        <button class="px-3 py-1 rounded-lg bg-purple-600 text-white text-sm font-medium">
                            1
                        </button>
                        <button class="px-3 py-1 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a] text-gray-400 hover:text-white hover:border-purple-600 transition text-sm">
                            2
                        </button>
                        <button class="px-3 py-1 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a] text-gray-400 hover:text-white hover:border-purple-600 transition text-sm">
                            3
                        </button>
                        <button class="px-3 py-1 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a] text-gray-400 hover:text-white hover:border-purple-600 transition text-sm">
                            Next
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

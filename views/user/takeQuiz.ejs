<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Take Quiz - Quizzy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #0a0a0a;
            color: white;
        }

        .answer-option {
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid #2a2a2a;
        }

        .answer-option:hover {
            border-color: #7c3aed;
            background: #1a1a1a;
        }

        .answer-option.selected {
            border-color: #7c3aed;
            background: #7c3aed20;
        }

        .answer-option.correct {
            border-color: #22c55e;
            background: #22c55e20;
        }

        .answer-option.incorrect {
            border-color: #ef4444;
            background: #ef444420;
        }

        .progress-bar {
            height: 8px;
            background: #2a2a2a;
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(to right, #7c3aed, #a855f7);
            transition: width 0.3s ease;
        }

        .timer {
            background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 16px;
        }

        .question-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 32px;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</head>
<body>
    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <div class="bg-[#1a1a1a] border-b border-[#2a2a2a] px-8 py-4">
            <div class="max-w-5xl mx-auto flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-purple-800 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-lg">Q</span>
                    </div>
                    <div>
                        <h1 id="quizTitle" class="text-xl font-bold">Loading...</h1>
                        <p id="quizTheme" class="text-sm text-gray-400">Quiz</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <!-- Timer -->
                    <div class="timer">
                        <div class="flex items-center space-x-2">
                            <svg class="w-5 h-5 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                            </svg>
                            <span id="timer" class="text-lg font-bold text-white">00:00</span>
                        </div>
                    </div>
                    <!-- Exit Button -->
                    <button onclick="exitQuiz()" class="px-4 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-500 rounded-lg transition">
                        Exit
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 px-8 py-8">
            <div class="max-w-5xl mx-auto">
                <!-- Progress -->
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-gray-400">Question <span id="currentQuestion">1</span> of <span id="totalQuestions">0</span></span>
                        <span class="text-sm text-gray-400">Progress: <span id="progressPercent">0</span>%</span>
                    </div>
                    <div class="progress-bar">
                        <div id="progressBar" class="progress-fill" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Question Card -->
                <div id="questionContainer" class="question-card mb-6">
                    <div class="text-center py-12">
                        <div class="inline-block w-12 h-12 border-4 border-purple-600 border-t-transparent rounded-full animate-spin mb-4"></div>
                        <p class="text-gray-400">Loading quiz...</p>
                    </div>
                </div>

                <!-- Navigation -->
                <div id="navigationButtons" class="flex items-center justify-between" style="display: none;">
                    <button id="prevBtn" onclick="previousQuestion()" class="px-6 py-3 bg-[#1a1a1a] hover:bg-[#2a2a2a] border border-[#2a2a2a] rounded-lg font-medium transition" disabled>
                        Previous
                    </button>
                    <button id="nextBtn" onclick="nextQuestion()" class="px-8 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-medium transition">
                        Next Question
                    </button>
                    <button id="submitBtn" onclick="submitQuiz()" class="px-8 py-3 bg-green-600 hover:bg-green-700 rounded-lg font-medium transition" style="display: none;">
                        Submit Quiz
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let quiz = null;
        let questions = [];
        let currentQuestionIndex = 0;
        let userAnswers = {};
        let startTime = Date.now();
        let timerInterval = null;
        let timeLimit = 0; // in seconds

        // Get quiz ID from URL
        const urlParams = new URLSearchParams(window.location.search);
        const quizId = urlParams.get('id');

        document.addEventListener('DOMContentLoaded', () => {
            if (!quizId) {
                alert('Invalid quiz ID');
                window.location.href = '/user/quizzes';
                return;
            }
            loadQuiz();
        });

        async function loadQuiz() {
            try {
                const response = await fetch(`/api/quizzes/${quizId}/take`);
                const data = await response.json();

                if (data.success) {
                    quiz = data.quiz;
                    questions = data.questions;
                    
                    // Set quiz info
                    document.getElementById('quizTitle').textContent = quiz.title;
                    document.getElementById('quizTheme').textContent = quiz.theme?.name || 'Quiz';
                    document.getElementById('totalQuestions').textContent = questions.length;
                    
                    // Initialize timer
                    timeLimit = quiz.time_limit * 60; // convert to seconds
                    startTimer();
                    
                    // Show first question
                    showQuestion(0);
                    document.getElementById('navigationButtons').style.display = 'flex';
                } else {
                    alert('Failed to load quiz: ' + (data.message || 'Unknown error'));
                    window.location.href = '/user/quizzes';
                }
            } catch (error) {
                console.error('Error loading quiz:', error);
                alert('Error loading quiz. Please try again.');
                window.location.href = '/user/quizzes';
            }
        }

        function startTimer() {
            let remainingTime = timeLimit;
            
            timerInterval = setInterval(() => {
                remainingTime--;
                
                const minutes = Math.floor(remainingTime / 60);
                const seconds = remainingTime % 60;
                document.getElementById('timer').textContent = 
                    `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                
                // Warning when 5 minutes left
                if (remainingTime === 300) {
                    alert('5 minutes remaining!');
                }
                
                // Time's up
                if (remainingTime <= 0) {
                    clearInterval(timerInterval);
                    alert('Time is up! Submitting quiz...');
                    submitQuiz();
                }
            }, 1000);
        }

        function showQuestion(index) {
            currentQuestionIndex = index;
            const question = questions[index];
            
            // Update progress
            document.getElementById('currentQuestion').textContent = index + 1;
            const progress = ((index + 1) / questions.length) * 100;
            document.getElementById('progressPercent').textContent = Math.round(progress);
            document.getElementById('progressBar').style.width = progress + '%';
            
            // Render question
            const container = document.getElementById('questionContainer');
            const answers = question.answers || [];
            const questionType = question.question_type;
            const savedAnswer = userAnswers[question.id];
            
            container.innerHTML = `
                <div class="mb-8">
                    <div class="flex items-start justify-between mb-4">
                        <h2 class="text-2xl font-bold flex-1">${escapeHtml(question.question_text)}</h2>
                        <span class="px-3 py-1 bg-purple-600/20 text-purple-400 rounded-full text-sm font-medium ml-4">
                            ${question.points} points
                        </span>
                    </div>
                    ${questionType === 'multiple' ? '<p class="text-sm text-gray-400 mb-4">Select all correct answers</p>' : ''}
                </div>
                
                <div class="space-y-3">
                    ${answers.map((answer, idx) => {
                        const isSelected = savedAnswer && savedAnswer.includes(idx);
                        return `
                            <div class="answer-option ${isSelected ? 'selected' : ''} p-4 rounded-lg" 
                                 onclick="selectAnswer(${question.id}, ${idx}, '${questionType}')">
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0 w-6 h-6 rounded-full border-2 ${isSelected ? 'border-purple-600 bg-purple-600' : 'border-gray-500'} flex items-center justify-center">
                                        ${isSelected ? '<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>' : ''}
                                    </div>
                                    <span class="flex-1 text-lg">${escapeHtml(answer.text)}</span>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;
            
            // Update navigation buttons
            document.getElementById('prevBtn').disabled = index === 0;
            document.getElementById('nextBtn').style.display = index === questions.length - 1 ? 'none' : 'block';
            document.getElementById('submitBtn').style.display = index === questions.length - 1 ? 'block' : 'none';
        }

        function selectAnswer(questionId, answerIndex, questionType) {
            if (!userAnswers[questionId]) {
                userAnswers[questionId] = [];
            }
            
            if (questionType === 'single') {
                // Single choice - replace answer
                userAnswers[questionId] = [answerIndex];
            } else {
                // Multiple choice - toggle answer
                const idx = userAnswers[questionId].indexOf(answerIndex);
                if (idx > -1) {
                    userAnswers[questionId].splice(idx, 1);
                } else {
                    userAnswers[questionId].push(answerIndex);
                }
            }
            
            // Re-render current question to update UI
            showQuestion(currentQuestionIndex);
        }

        function previousQuestion() {
            if (currentQuestionIndex > 0) {
                showQuestion(currentQuestionIndex - 1);
            }
        }

        function nextQuestion() {
            if (currentQuestionIndex < questions.length - 1) {
                showQuestion(currentQuestionIndex + 1);
            }
        }

        function exitQuiz() {
            if (confirm('Are you sure you want to exit? Your progress will be lost.')) {
                clearInterval(timerInterval);
                window.location.href = '/user/quizzes';
            }
        }

        async function submitQuiz() {
            // Check if all questions are answered
            const unanswered = questions.filter(q => !userAnswers[q.id] || userAnswers[q.id].length === 0);
            if (unanswered.length > 0) {
                if (!confirm(`You have ${unanswered.length} unanswered question(s). Submit anyway?`)) {
                    return;
                }
            }
            
            clearInterval(timerInterval);
            
            // Calculate time taken
            const timeTaken = Math.floor((Date.now() - startTime) / 1000);
            
            // Prepare submission data
            const submissionData = {
                quiz_id: quizId,
                answers: userAnswers,
                time_taken: timeTaken
            };
            
            try {
                const response = await fetch('/api/quizzes/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(submissionData)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Redirect to results page
                    window.location.href = `/user/quiz/results?attempt=${data.attemptId}`;
                } else {
                    alert('Failed to submit quiz: ' + (data.message || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error submitting quiz:', error);
                alert('Error submitting quiz. Please try again.');
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Prevent accidental page close
        window.addEventListener('beforeunload', (e) => {
            if (timerInterval) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
    </script>
</body>
</html>
